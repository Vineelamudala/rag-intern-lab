# Copy to .env (which is git-ignored) and fill in. Never commit .env or real credentials.

# --- PostgreSQL / pgvector (used by compose.yaml and the Python code) ---------
POSTGRES_USER=rag
# Choose any local password; it only protects the database on your own machine.
POSTGRES_PASSWORD=
POSTGRES_DB=rag_lab
POSTGRES_HOST=localhost
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433
# Optional: a full URL overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql://rag:<password>@localhost:5433/rag_lab

# --- Documents and evaluation ---------------------------------------------------
RAG_DOCS_DIR=data/rag_docs
RAG_QUERIES_FILE=data/rag_test_queries.md

# --- Local embeddings (no API key; runs on your machine) -------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the model's output size. Changing it requires re-running ingestion.
EMBEDDING_DIM=384

# --- Chunking -----------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ----------------------------------------------------------------
TOP_K=4
# Cosine similarity cut-off; chunks below it are treated as "not relevant".
MIN_SIMILARITY=0.30

# --- Answer generation: organisation LiteLLM gateway ----------------------------
# Get these three values from your mentor / platform team. Do not guess them,
# do not share your key, and do not paste it into code, tests or PR descriptions.
LITELLM_API_BASE=
LITELLM_API_KEY=
LITELLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
